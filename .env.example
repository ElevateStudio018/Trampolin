# --- Required ---
DATABASE_URL=postgres://trampolin:trampolin@localhost:5432/trampolin_dev
# Public origin of the app; used for CSRF origin checks on API routes.
APP_ORIGIN=http://localhost:3000

# --- Storage (local filesystem by default) ---
STORAGE_DIR=./storage
VIDEO_MAX_BYTES=209715200

# --- Optional: language model for the assistant and research extraction ---
# Without this the assistant runs in retrieval-only mode and research extraction is excerpt-based.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Hard daily cap on model tokens across all users (input + output).
LLM_DAILY_TOKEN_BUDGET=200000

# --- Optional: web search for the research agent ---
# Supported: brave | tavily. Without a provider, research jobs only run gap analysis
# and process sources that reviewers attach manually.
SEARCH_PROVIDER=
SEARCH_API_KEY=
# Comma-separated domains the research agent may fetch from (empty = any https domain allowed by robots.txt).
RESEARCH_ALLOWED_DOMAINS=

# --- Optional: external video-analysis model service ---
# HTTP endpoint implementing the contract in docs/VIDEO_ANALYSIS.md. Unset = trick recognition unavailable.
VIDEO_MODEL_ENDPOINT=
VIDEO_MODEL_API_KEY=
